APP_NAME=OpenMinetopia
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=https://central.mtportal.nl

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Central database (tenants, domains, cache). Tenant databases live on the same
# MySQL server; each tenant brings its own name, username and password.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=omt_portal_central
DB_USERNAME=
DB_PASSWORD=

# Sessions are stored in each tenant's own database.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# File cache, one directory per tenant (storage/framework/cache/data/tenants/{id}).
CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# single: one portal for your own server (the default; set up with
#         php artisan portal:install). hosted: the multi-tenant app on *.mtportal.nl.
PORTAL_MODE=single

# Demo mode: fake plugin data, for trying the portal or making screenshots.
# Load the data with: php artisan db:seed --class=DemoSeeder. Ignored in production.
PORTAL_DEMO=false

# Hosted mode only. Hosts that never resolve to a tenant; only these serve the
# provisioning API (/internal/v1). Comma separated.
TENANCY_CENTRAL_DOMAINS=central.mtportal.nl

# Hosted mode only. Shared with the OMT website (its PORTAL_PROVISIONING_SECRET);
# signs every provisioning request with HMAC-SHA256.
PORTAL_PROVISIONING_SECRET=

# Lifetime of the one-time admin claim link, and the scheme of tenant URLs.
ADMIN_CLAIM_TTL_MINUTES=30
TENANT_URL_SCHEME=https

# The plugin and the server. portal:install fills these in. In hosted mode they
# come from each tenant: leave them empty there.
MC_SERVER_ADDRESS=
PLUGIN_API_URL=
PLUGIN_API_KEY=
MINECRAFT_API_KEY=
